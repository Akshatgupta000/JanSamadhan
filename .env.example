# ==============================================================================
# JanSamadhan Innovation Hub - Environment Configuration Template
# ==============================================================================

# Server Configuration
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Database (PostgreSQL with pgvector & PostGIS)
DATABASE_URL=postgresql://jansamadhan:jansamadhan_secret@localhost:5432/jansamadhan_db?schema=public

# Redis & Background Jobs (BullMQ)
REDIS_URL=redis://localhost:6379

# JWT Security
JWT_ACCESS_SECRET=dev_jwt_access_secret_min_32_characters_random_string_here
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_min_32_characters_random_string_here
JWT_REFRESH_EXPIRATION=7d

# File Storage Configuration
# Storage Provider: 'local' | 's3'
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./uploads
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=jansamadhan-evidence
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# Email Notification Adapter
# Provider: 'mock' | 'smtp'
EMAIL_PROVIDER=mock
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=JanSamadhan <no-reply@jansamadhan.jharkhand.gov.in>

# AI Provider Configuration
# Provider: 'mock' | 'gemini' | 'openai'
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL_NAME=gemini-1.5-flash
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL_NAME=text-embedding-004
EMBEDDING_DIMENSION=768

# Logging
LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

